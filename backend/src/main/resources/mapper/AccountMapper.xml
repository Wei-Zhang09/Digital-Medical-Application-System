<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qst.medical.mapper.AccountMapper">

    <!-- 登录查询：角色存在 account.utype 列，用 utype AS role 一并映射给 AccountDo.role -->
    <select id="selectAccountByUname" resultType="com.qst.medical.domain.dto.AccountDto">
        SELECT id,
               realname,
               uname,
               pwd,
               phonenumber,
               utype,
               utype AS role,
               createtime,
               updatetime
        FROM account
        WHERE uname = #{uname}
    </select>

</mapper>

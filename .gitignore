# 构建产物
backend/target/
frontend/dist/
frontend/node_modules/
frontend/.eslintcache
frontend/npm-debug.log*

# 本机开发环境（Node 22、MySQL 数据目录、临时文件、日志）
.dev/

# 上传的图片
uploads/
backend/uploads/

# IDE
.idea/
*.iml
.vscode/
.history/

# 系统
Thumbs.db
.DS_Store
*.log

# 报告 PDF 预览（体积大，推不上去；由 docx 导出生成）
docs/report/*.pdf
# 报告 docx 是生成物（scripts/export_report.py 可随时重建），体积大且推送易超时，不进版本库
docs/report/*.docx

# 交接文档只留本地（含环境细节与密钥），不进仓库
HANDOVER.md
# 交付压缩包（16MB，推送超时；用 scripts/package.sh 重建）
docs/report/*.zip

# 本机数据库口令（不进仓库）
**/application-local.properties
